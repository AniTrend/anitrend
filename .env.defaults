DJANGO_DEBUG=True
DJANGO_SECRET_KEY=test-key
DJANGO_LANGUAGE_CODE=en-us
DJANGO_TIME_ZONE=UTC
DJANGO_SETTINGS_MODULE=app.settings.development
DJANGO_CRUNCHY_TOKEN=DJANGO_CRUNCHY_TOKEN
DJANGO_REDIS_URI=redis://localhost:6379/0

# GrowthBook configuration
GROWTH_BOOK_HOST=GROWTH_BOOK_HOST
GROWTH_BOOK_KEY=GROWTH_BOOK_KEY
GROWTH_BOOK_TTL=600

EDGE_HOST=http://localhost:8888

ALLOWED_HOSTS=localhost
CSRF_TRUSTED_ORIGINS=http://localhost
APP_NAME=app

# Gunicorn configuration
GUNICORN_PORT=8800
GUNICORN_WORKERS=2
GUNICORN_TIMEOUT=5000
GUNICORN_LOG_LEVEL=INFO

# OTEL configuration
OTEL_SERVICE_NAME="anitrend"
OTEL_EXPORTER_OTLP_ENDPOINT="http://otel-collector:4317"
OTEL_EXPORTER_OTLP_METRICS_ENDPOINT="http://otel-collector:4317/v1/metrics"
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT="http://otel-collector:4317/v1/traces"
OTEL_EXPORTER_OTLP_LOGS_ENDPOINT="http://otel-collector:4317/v1/logs"

# Traefik configuration
PORT=8800
HOST=anitrend.docker.localhost
